# ==============================================================================
# Supply Guard 2.0 — Environment Configuration Template
# NOTE: Copy this file to .env (or configure in Vercel / Render / Railway dashboard)
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# --- Frontend Configuration (Vercel) ---
# The public URL of the deployed backend ML API.
# Leave blank for local dev (defaults to http://127.0.0.1:8000/api).
VITE_API_URL=https://your-production-backend.com/api

# --- Backend API & Model Server Configuration ---
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated).
# Include your Vercel production domain and local dev domains.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Optional: Path overrides for mounted storage (defaults to relative directory paths)
# MODEL_DIR=supply_guard_models
# DATA_DIR=supply datra
# WEATHER_MODEL_PATH=weather/weather_final.pkl

# Optional AI Explainer Key (Google Gemini for executive natural-language summaries)
# If omitted, deterministic rule-based explainers operate without external network calls.
GEMINI_API_KEY=
